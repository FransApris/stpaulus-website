# 🔒 SECURITY NOTICE:
# This is a template file. DO NOT use these values in production!
# Generate strong, unique values for each environment variable.

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
DATABASE_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_database_user
MYSQL_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_32_CHARS
MYSQL_DATABASE=stpaulus_cms_db

# 🔒 SECURITY TIP for Database Password:
# Use a password generator to create a strong password with:
# - Minimum 32 characters
# - Mix of uppercase, lowercase, numbers, and special characters
# Example: Xk9$mP#vL2@rT8!qW5^nD1&zA4*cF7+hB3%gJ6

# ============================================
# JWT AUTHENTICATION (REQUIRED)
# ============================================
# CRITICAL: Generate a unique secret key (minimum 32 characters)
# Use this command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING

# 🔒 SECURITY TIP for JWT Secret:
# Run this in your terminal to generate a secure secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# In production, specify your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 🔒 PRODUCTION EXAMPLE:
# ALLOWED_ORIGINS=https://stpaulus.com,https://www.stpaulus.com,https://admin.stpaulus.com

# ============================================
# GOOGLE OAUTH (OPTIONAL)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ============================================
# GROQ API (FOR CHATBOT)
# ============================================
GROQ_API_KEY=your_groq_api_key

# ============================================
# GOOGLE GEMINI AI (FOR KRONIK NARRATION)
# ============================================
# Get your free API key from: https://makersuite.google.com/app/apikey
# Used for AI-powered narration generation in Kronik management
GEMINI_API_KEY=your_gemini_api_key_here

# 📝 HOW TO GET GEMINI API KEY:
# 1. Visit https://makersuite.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key" button
# 4. Copy the generated key and paste it here
# 
# 💡 TIPS:
# - Free tier includes 60 requests per minute
# - Perfect for generating kronik narratives
# - Supports Indonesian language very well

# ============================================
# GOOGLE PHOTOS API (FOR GALLERY INTEGRATION)
# ============================================
# Hybrid storage: Local thumbnails + Google Photos full images
# Setup guide: GOOGLE_PHOTOS_HYBRID_GUIDE.md
GOOGLE_PHOTOS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_PHOTOS_CLIENT_SECRET=your_client_secret
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:3000/api/google-photos/callback
GOOGLE_PHOTOS_USER_EMAIL=your_google_photos_email@gmail.com
GOOGLE_PHOTOS_DOWNLOAD_THUMBNAILS=true
GOOGLE_PHOTOS_THUMBNAIL_SIZE=400

# 📝 HOW TO GET GOOGLE PHOTOS API CREDENTIALS:
# 1. Visit https://console.cloud.google.com/
# 2. Create a new project (e.g., "StPaulus Website")
# 3. Enable "Photos Library API"
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add redirect URI: http://localhost:3000/api/google-photos/callback
# 6. Copy Client ID and Client Secret
# 
# 💡 BENEFITS:
# - Unlimited photo storage via Google Photos
# - Fast loading with local thumbnails
# - SEO friendly with metadata in database
# - Auto backup to Google Photos
#
# 📖 Full documentation: GOOGLE_PHOTOS_HYBRID_GUIDE.md

# 🔒 SECURITY TIP:
# Keep this file (.env.example) in version control as a template
# NEVER commit your actual .env file with real credentials!

# ============================================
# CLOUDINARY (FOR DOCUMENT & IMAGE STORAGE)
# ============================================
# Required for persistent file storage on Railway (recommended over Volume)
# Free tier: 25GB storage + 25GB bandwidth/month
#
# 📝 HOW TO GET CLOUDINARY CREDENTIALS:
# 1. Visit https://cloudinary.com/users/register_free
# 2. Sign in and open your Dashboard
# 3. Under "Account Details", copy:
#    - Cloud Name  (e.g. dxxxxxxxx)
#    - API Key     (e.g. 123456789012345)
#    - API Secret  (e.g. abcdefghijklmnopqrstuvwxyz123456)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
#
# When these 3 vars are set, ALL file uploads (dokumen, foto, artikel)
# will go to Cloudinary automatically. No other code change needed.
# 
# 💡 RAILWAY SETUP:
# Dashboard → Project → Service "web" → Variables → Add:
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET

# ============================================
# QUICK START CHECKLIST:
# ============================================
# 1. Copy this file to .env
# 2. Generate strong JWT_SECRET (see command above)
# 3. Generate strong MYSQL_PASSWORD
# 4. Update ALLOWED_ORIGINS for production
# 5. Set CLOUDINARY_CLOUD_NAME / API_KEY / API_SECRET
# 6. Fill in other API keys as needed
# 7. NEVER commit .env file to Git

# ============================================
# BACKUP SCHEDULER (OTOMATIS)
# ============================================
# Backup otomatis berjalan di production & staging secara default.
# Untuk mengaktifkan di local development, set ke "true".
#
# Default: false (di development), true otomatis (di production/staging)
ENABLE_BACKUP_SCHEDULER=false

# Interval backup dalam JAM (default: 6 jam = RPO target 6 jam)
# Ubah ke 4 untuk RPO 4 jam, dst.
BACKUP_INTERVAL_HOURS=6

# Retensi backup dalam HARI — file lebih lama akan dihapus otomatis
# Default: 30 hari
BACKUP_RETENTION_DAYS=30

# 💡 RAILWAY SETUP untuk Backup Scheduler:
# Dashboard → Project → Service "web" → Variables → Add:
#   ENABLE_BACKUP_SCHEDULER=true  (tidak perlu, sudah otomatis di production)
#   BACKUP_INTERVAL_HOURS=6       (opsional, default sudah 6)
#   BACKUP_RETENTION_DAYS=30      (opsional, default sudah 30)
#
# 💡 Monitoring status scheduler:
#   GET /api/admin/security/scheduler  (login sebagai super_admin)
#
# 💡 Trigger backup manual dari API (tanpa SSH):
#   GET /api/admin/security/scheduler?action=backup-now
#
# 💡 Trigger cleanup manual:
#   GET /api/admin/security/scheduler?action=cleanup-now




[phases.setup]
nixPkgs = ["nodejs_22"]

[phases.install]
cmds = [
  "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm install --ignore-scripts --force --legacy-peer-deps --prefer-offline"
]

[phases.build]
cmds = [
  "npm run build",
  "npm prune --production"
]

[phases.optimize]
cmds = [
  "rm -rf .nuxt/analyze",
  "rm -rf node_modules/.cache",
  "find node_modules -name '*.md' -type f -delete",
  "find node_modules -name 'LICENSE*' -type f -delete"
]

[start]
cmd = "node .output/server/index.mjs"

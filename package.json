{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:quiet": "cross-env NODE_OPTIONS=--disable-warning=DEP0155 nuxt build",
    "dev": "nuxt dev",
    "dev:auto": "bash scripts/start-dev.sh",
    "dev:auto:win": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-windows.ps1",
    "mysql:start": "sudo /usr/local/mysql/support-files/mysql.server start",
    "mysql:stop": "sudo /usr/local/mysql/support-files/mysql.server stop",
    "mysql:status": "sudo /usr/local/mysql/support-files/mysql.server status",
    "mysql:start:win": "powershell -ExecutionPolicy Bypass -File scripts/mysql-windows.ps1 -Action start",
    "mysql:stop:win": "powershell -ExecutionPolicy Bypass -File scripts/mysql-windows.ps1 -Action stop",
    "mysql:status:win": "powershell -ExecutionPolicy Bypass -File scripts/mysql-windows.ps1 -Action status",
    "mysql:restart:win": "powershell -ExecutionPolicy Bypass -File scripts/mysql-windows.ps1 -Action restart",
    "clean:win": "powershell -ExecutionPolicy Bypass -File scripts/clean-dev-windows.ps1",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare:nuxt": "nuxt prepare",
    "db:test": "node scripts/test-db-connection.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:backup": "node scripts/backup-database.js",
    "db:info": "node scripts/test-db-connection.js",
    "google-photos:test": "node scripts/test-google-photos.mjs",
    "google-photos:migrate": "powershell -ExecutionPolicy Bypass -File scripts/run-google-photos-migration-simple.ps1"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "7.3.0",
    "@google/generative-ai": "^0.24.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/kit": "^4.4.2",
    "@nuxtjs/pwa": "^3.3.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "groq-sdk": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "nuxt": "^4.4.2",
    "tw-elements": "^2.0.0",
    "vue": "^3.5.30",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.19.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "0.19.11",
    "postcss-import": "^16.1.1",
    "puppeteer": "^24.31.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  }
}